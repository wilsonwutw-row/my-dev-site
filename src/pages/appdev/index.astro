---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const logs = (await getCollection('appdev', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---
<BaseLayout title="App 開發日誌｜Republic of Wilson">
  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Build in Public</div>
          <h2>App 開發日誌 · 全部紀錄</h2>
        </div>
      </div>
      <div class="grid">
        {logs.map((log) => (
          <a class="card" href={`/appdev/${log.id}/`}>
            <span class="tag">{log.data.stage}</span>
            <h3>{log.data.title}</h3>
            <div class="meta">{formatDate(log.data.date)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
