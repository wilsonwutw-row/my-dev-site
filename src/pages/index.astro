---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const STAGES = ['企劃', '設計', '開發', '測試', '上線'] as const;

const softwarePosts = (await getCollection('software', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const appdevLogs = (await getCollection('appdev', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const interestPosts = (await getCollection('interests', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const currentStageIndex = STAGES.indexOf(site.appStage as (typeof STAGES)[number]);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---
<BaseLayout>
  <div class="hero" id="home">
    <div class="wrap">
      <img class="mark" src="/row-icon.png" alt="Republic of Wilson logo">
      <h1>{site.heroTitle}</h1>
      <p class="lede">{site.heroSubtitle}</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#software">閱讀最新文章</a>
        <a class="btn btn-ghost" href="#appdev">查看 App 開發進度</a>
      </div>
    </div>
  </div>

  <section id="software">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Software Notes</div>
          <h2>軟體心得</h2>
        </div>
        <a class="more" href="/software/">查看全部文章 →</a>
      </div>
      <div class="grid">
        {softwarePosts.map((post) => (
          <a class="card" href={`/software/${post.id}/`}>
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">{formatDate(post.data.pubDate)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="appdev" style="background:var(--bg-alt);">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Build in Public</div>
          <h2>App 開發進度</h2>
        </div>
        <a class="more" href="/appdev/">查看全部日誌 →</a>
      </div>
      <div class="appdev-box">
        <div class="appdev-top">
          <div>
            <h3>{site.appProjectName}</h3>
            <p>{site.appDescription}</p>
          </div>
          <span class="status-pill">{site.appStage}中</span>
        </div>
        <div class="timeline">
          {STAGES.map((stage, i) => (
            <div class={`step ${i < currentStageIndex ? 'done' : ''} ${i === currentStageIndex ? 'active' : ''}`}>
              <div class="dot"></div>
              <span>{stage}</span>
            </div>
          ))}
        </div>
        {appdevLogs.length > 0 && (
          <ul class="appdev-log">
            {appdevLogs.map((log) => (
              <li>
                <a href={`/appdev/${log.id}/`}>{log.data.title}</a>
                <span class="log-date">{log.data.stage} · {formatDate(log.data.date)}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <section id="interests">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Learning & Life</div>
          <h2>語言學習 & 個人興趣</h2>
        </div>
        <a class="more" href="/interests/">查看全部文章 →</a>
      </div>
      <div class="grid">
        {interestPosts.map((post) => (
          <a class="card" href={`/interests/${post.id}/`}>
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">{formatDate(post.data.pubDate)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="about">
    <div class="wrap">
      <div class="about">
        <div class="avatar">W</div>
        <div class="about-text">
          <h3>關於 Republic of Wilson</h3>
          <p>{site.aboutText}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
