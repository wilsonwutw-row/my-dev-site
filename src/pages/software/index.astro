---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('software', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---
<BaseLayout title="軟體心得｜Republic of Wilson">
  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="eyebrow">Software Notes</div>
          <h2>軟體心得 · 全部文章</h2>
        </div>
      </div>
      <div class="grid">
        {posts.map((post) => (
          <a class="card" href={`/software/${post.id}/`}>
            <span class="tag">{post.data.tag}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">{formatDate(post.data.pubDate)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
